# publish-wizard.sh / publish-release.sh 설정 템플릿.
#
# 이 파일을 같은 폴더의 publish.env 로 복사한 뒤 값을 채우면,
# 위저드가 매번 묻지 않고 자동으로 사용합니다.
#   cp tools/publish.env.example tools/publish.env
#
# 환경변수로 같은 이름을 export 해두면(예: export SERVER_ROOT=...) 그 값이
# 이 파일보다 우선합니다.

# 서버 루트. 가이드 1편 기본 예시는 /srv/ue-dt-updates,
# 회사 서버 기준 예시는 /dt/ue-dt-updates 입니다.
SERVER_ROOT="/srv/ue-dt-updates"

# 클라이언트가 접속할 주소의 시작 부분.
# catalog/manifest 안의 URL이 이 값으로 만들어지므로 반드시 클라이언트 입장의 주소.
# 예: http://10.10.20.5  또는  https://updates.example.com
BASE_URL_ROOT="http://127.0.0.1"

# 업로드된 .zip 을 두는 디렉터리. 기본값은 $SERVER_ROOT/incoming.
INCOMING_DIR="/srv/ue-dt-updates/incoming"
