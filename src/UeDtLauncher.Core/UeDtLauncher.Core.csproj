<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>UeDtLauncher.Core</AssemblyName>
    <RootNamespace>UeDtLauncher</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UeDtLauncher" />
    <InternalsVisibleTo Include="UeDtLauncher.Developer" />
    <InternalsVisibleTo Include="UeDtLauncher.Agent" />
    <InternalsVisibleTo Include="UeDtLauncher.Tests" />
    <InternalsVisibleTo Include="UeDtLauncher.RuntimeFaultHarness" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
