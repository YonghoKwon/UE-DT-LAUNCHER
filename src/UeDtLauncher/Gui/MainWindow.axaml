<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UeDtLauncher.Gui.MainWindow"
        Title="UE-DT Launcher"
        Width="920"
        Height="640"
        MinWidth="760"
        MinHeight="520">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24" RowSpacing="16">
    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock Text="UE-DT Launcher" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="Update, repair, and launch your Unreal packaged application." Opacity="0.72" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
      <TextBox x:Name="ConfigPathBox" Text="launcher.config.json" Watermark="launcher.config.json" />
      <Button Grid.Column="1" Content="Update &amp;&amp; Launch" Click="OnUpdateLaunchClicked" />
      <Button Grid.Column="2" Content="Repair" Click="OnRepairClicked" />
      <Button Grid.Column="3" Content="Update Only" Click="OnUpdateOnlyClicked" />
    </Grid>

    <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
      <StackPanel Grid.Row="0" Spacing="6">
        <TextBlock x:Name="StatusText" Text="Ready" />
        <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" />
      </StackPanel>
      <TextBox Grid.Row="1" x:Name="LogBox" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" />
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Create Sample Config" Click="OnSampleConfigClicked" />
      <Button Content="Clear Log" Click="OnClearLogClicked" />
    </StackPanel>
  </Grid>
</Window>
