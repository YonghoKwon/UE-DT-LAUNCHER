<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName Condition="'$(LauncherEdition)' == 'General'">UeDtLauncher</AssemblyName>
    <AssemblyName Condition="'$(LauncherEdition)' == 'Developer'">UeDtLauncher.Developer</AssemblyName>
    <DefineConstants Condition="'$(LauncherEdition)' == 'Developer'">$(DefineConstants);LAUNCHER_DEVELOPER</DefineConstants>
    <RootNamespace>UeDtLauncher</RootNamespace>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UeDtLauncher.Tests" />
    <AvaloniaResource Include="Assets/Branding/posco-dx-korean.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UeDtLauncher.Core\UeDtLauncher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.14" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.14" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.14" />
  </ItemGroup>
  <Target Name="ValidateLauncherEdition" BeforeTargets="Restore;PrepareForBuild;Publish">
    <Error Condition="'$(LauncherEdition)' != 'General' and '$(LauncherEdition)' != 'Developer'" Text="LauncherEdition must be General or Developer." />
  </Target>
</Project>
